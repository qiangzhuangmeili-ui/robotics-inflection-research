        "next_action": "REQUEST_PERMISSION"
      },
      "verification": {
        "nature": "SELF_CHECK",
        "checks": [
          "MAGIC_HEADER",
          "SIZE_FLOOR",
          "PDF_OPENABLE",
          "PAGE_COUNT_FLOOR",
          "ISSUER_MATCH",
          "PERIOD_MATCH",
          "FORM_FULL_TEXT",
          "CONTENT_LENGTH",
          "SHA256"
        ],
        "verified_by": "WorkBuddy AI",
        "verified_at_utc": "2026-10-26T08:41:48Z"
      },
      "created_at_utc": "2026-10-26T08:41:48Z"
    }
  }
}